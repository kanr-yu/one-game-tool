<Page x:Class="GameDeck.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:actions="clr-namespace:GameDeck.Infrastructure"
      Style="{StaticResource PageStyle}" Title="设置与自律">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,30,32,28">
            <TextBlock Text="MAKE IT YOURS" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="设置与自律" Style="{StaticResource PageTitle}" />
            <TextBlock Text="保持工具轻盈，也为生活留一点空间。" Style="{StaticResource MutedText}" />
            <TextBlock Text="应用维护" Style="{StaticResource SectionTitle}" Margin="0,28,0,16" />
            <Border Style="{StaticResource Card}" Padding="24,6">
                <StackPanel>
                    <Grid Margin="0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Image24" Foreground="{StaticResource AccentBrush}" FontSize="23" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="0,0,24,0">
                            <TextBlock Text="封面缓存" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="移除本软件缓存的封面图片，需要时可重新获取。" Style="{StaticResource MutedText}" Margin="0,7,0,0" />
                        </StackPanel>
                        <ui:Button Grid.Column="2" Content="清空本软件封面缓存" Style="{StaticResource ActionButton}" VerticalAlignment="Center"
                                   Command="{x:Static actions:PreviewActions.ShowFeature}" CommandParameter="清空本软件封面缓存" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource LineBrush}" />
                    <Grid Margin="0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Database24" Foreground="{StaticResource WarmBrush}" FontSize="23" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="0,0,24,0">
                            <TextBlock Text="本地数据库" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="收缩空闲空间，整理本地游戏索引与管理数据。" Style="{StaticResource MutedText}" Margin="0,7,0,0" />
                        </StackPanel>
                        <ui:Button Grid.Column="2" Content="收缩优化本地数据库" Style="{StaticResource ActionButton}" VerticalAlignment="Center"
                                   Command="{x:Static actions:PreviewActions.ShowFeature}" CommandParameter="收缩优化本地数据库" />
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Text="自律与提醒" Style="{StaticResource SectionTitle}" Margin="0,28,0,16" />
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="适时休息提醒" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="连续游玩 60 分钟后提醒起身走走。" Style="{StaticResource MutedText}" Margin="0,7,0,0" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="False" OnContent="已开启" OffContent="已关闭" VerticalAlignment="Center"
                                     AutomationProperties.Name="适时休息提醒" Command="{x:Static actions:PreviewActions.ShowFeature}" CommandParameter="适时休息提醒" />
                </Grid>
            </Border>
            <Border CornerRadius="12" Background="#202C2B" Padding="24" Margin="0,28,0,0">
                <StackPanel>
                    <TextBlock Text="尽兴游戏，也照顾自己。" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="每一段冒险都值得投入，每一次休息也同样重要。" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            <DockPanel Margin="0,26,0,0">
                <TextBlock DockPanel.Dock="Right" Text="C# · .NET 8 · WPF UI" Style="{StaticResource MutedText}" FontSize="11" />
                <TextBlock Text="GameDeck  /  v0.1.0 Preview" Style="{StaticResource MutedText}" FontSize="11" />
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
