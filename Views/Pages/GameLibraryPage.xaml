<Page x:Class="GameDeck.Views.Pages.GameLibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:actions="clr-namespace:GameDeck.Infrastructure"
      Style="{StaticResource PageStyle}" Title="游戏库" Loaded="Page_Loaded"
      ScrollViewer.CanContentScroll="False" PreviewMouseWheel="Root_PreviewMouseWheel">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <actions:LocalCoverConverter x:Key="CoverConverter" />
    </Page.Resources>
    <Grid x:Name="RootContainer" Background="Transparent">
        <ScrollViewer x:Name="GameListScrollViewer"
                      Background="Transparent"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False" PanningMode="VerticalOnly">
            <StackPanel x:Name="LibraryContent" Background="Transparent" Margin="32,30,32,28">
                <TextBlock Text="YOUR COLLECTION" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="游戏库" Style="{StaticResource PageTitle}" />
                <TextBlock Text="所有热爱，尽在一处。从这里开启下一场冒险。" Style="{StaticResource MutedText}" />

                <Border Style="{StaticResource Card}" Margin="0,20,0,20" Padding="22,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="已收录游戏" Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding GameCount}" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="22,0,0,0">
                            <TextBlock Text="游戏占用空间" Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding TotalSizeFormatted}" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="22,0,0,0">
                            <TextBlock Text="存档备份" Style="{StaticResource MutedText}" />
                            <TextBlock Text="待接入" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="搜索名称、平台或路径…"
                                Icon="{ui:SymbolIcon Search24}" MinHeight="40" Margin="0,0,14,0"
                                AutomationProperties.Name="搜索游戏" VerticalContentAlignment="Center" />
                    <ui:Button Grid.Column="1" Content="手动添加游戏" Icon="{ui:SymbolIcon Add24}" Style="{StaticResource PrimaryButton}"
                               Command="{Binding AddGameCommand}" Margin="0,0,10,0" />
                    <ui:Button Grid.Column="2" Content="扫描平台" Icon="{ui:SymbolIcon Search24}" Style="{StaticResource ActionButton}"
                               Command="{x:Static actions:PreviewActions.ShowFeature}" CommandParameter="扫描平台" />
                </Grid>

                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,10"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <DockPanel Margin="0,0,0,16">
                    <ui:Button DockPanel.Dock="Right" Content="重新加载" Command="{Binding ReloadCommand}" Padding="10,5" Margin="15,0,0,0" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                </DockPanel>
                <Border Background="#382A25" BorderBrush="#775944" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource WarmBrush}" TextWrapping="Wrap" />
                </Border>

                <DockPanel Margin="0,0,0,16">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ResultsLabel}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    <TextBlock Text="全部游戏" FontSize="18" FontWeight="SemiBold" />
                </DockPanel>
                <ItemsControl x:Name="GamesItemsControl" Background="Transparent" ItemsSource="{Binding GamesView}" ScrollViewer.CanContentScroll="False" Margin="-6,0">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="{x:Type ItemsControl}">
                            <ItemsPresenter />
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Background="Transparent" Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="0" Margin="6,0,6,12">
                                <StackPanel>
                                    <Border Height="170" CornerRadius="11,11,0,0" ClipToBounds="True">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#254F50" Offset="0" /><GradientStop Color="#1A2634" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid ClipToBounds="True">
                                            <Ellipse Width="160" Height="160" Stroke="#28FFFFFF" StrokeThickness="1" HorizontalAlignment="Right" Margin="0,-54,-26,0" VerticalAlignment="Top" />
                                            <ui:SymbolIcon Symbol="Games24" FontSize="64" Opacity="0.4">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Source, ElementName=CoverImage}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                            <ui:Button x:Name="DeleteGameButton" Icon="{ui:SymbolIcon Delete24}" Width="32" Height="32"
                                                       Padding="6" Margin="12" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                       Appearance="Transparent" Background="#880E1417" ToolTip="移除或删除游戏"
                                                       AutomationProperties.Name="移除或删除游戏"
                                                       Command="{Binding DataContext.DeleteGameCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                       CommandParameter="{Binding}" />
                                            <Image x:Name="CoverImage" Source="{Binding CoverPath, Converter={StaticResource CoverConverter}}"
                                                   Width="112" Height="112" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                                   AutomationProperties.Name="游戏应用图标" />
                                            <Border Background="#550E1417" CornerRadius="4" Padding="7,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16">
                                                <TextBlock Text="{Binding Platform}" FontSize="9" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel Margin="16,17,16,12">
                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding InstallDirectory}" ToolTip="{Binding InstallDirectory}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,12" />
                                        <DockPanel Margin="0,0,0,16">
                                            <TextBlock Text="{Binding SizeFormatted}" DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock Text="●  本地游戏" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                                        </DockPanel>
                                        <ui:Button Content="启动游戏" Icon="{ui:SymbolIcon Play24}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"
                                                   Command="{Binding DataContext.LaunchGameCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                        <Grid Margin="0,8,0,14">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <ui:Button Content="备份存档" Padding="5,8" FontSize="12" MinHeight="36" HorizontalAlignment="Stretch" Margin="0,0,4,0"
                                                       Command="{x:Static actions:PreviewActions.ShowFeature}" CommandParameter="{Binding BackupAction}" />
                                            <ui:Button Grid.Column="1" Content="无损搬家" Padding="5,8" FontSize="12" MinHeight="36" HorizontalAlignment="Stretch" Margin="4,0,0,0"
                                                       Command="{x:Static actions:PreviewActions.ShowFeature}" CommandParameter="{Binding MoveAction}" />
                                        </Grid>
                                        <TextBlock Text="{Binding LastPlayedDisplay, StringFormat=上次游玩：{0}}" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource Card}" Padding="32">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding EmptyTitle}" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding EmptyDescription}" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
