<Page x:Class="GameDeck.Views.Pages.GameLibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:actions="clr-namespace:GameDeck.Infrastructure"
      Style="{StaticResource PageStyle}" Title="游戏库">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,30,32,28">
            <TextBlock Text="YOUR COLLECTION" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="游戏库" Style="{StaticResource PageTitle}" />
            <TextBlock Text="所有热爱，尽在一处。从这里开启下一场冒险。" Style="{StaticResource MutedText}" />

            <Border Style="{StaticResource Card}" Margin="0,20,0,20" Padding="22,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="已收录游戏" Style="{StaticResource MutedText}" />
                        <TextBlock Text="03" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="22,0,0,0">
                        <TextBlock Text="游戏占用空间" Style="{StaticResource MutedText}" />
                        <TextBlock Text="242.6 GB" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="22,0,0,0">
                        <TextBlock Text="存档备份" Style="{StaticResource MutedText}" />
                        <TextBlock Text="03 份" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="SearchBox" PlaceholderText="搜索你的游戏…" Icon="{ui:SymbolIcon Search24}"
                            MinHeight="40" Margin="0,0,14,0" TextChanged="SearchBox_TextChanged"
                            AutomationProperties.Name="搜索游戏" VerticalContentAlignment="Center" />
                <ui:Button Grid.Column="1" Content="手动添加游戏" Icon="{ui:SymbolIcon Add24}" Style="{StaticResource PrimaryButton}"
                           Command="{x:Static actions:PreviewActions.ShowFeature}" CommandParameter="手动添加游戏" Margin="0,0,10,0" />
                <ui:Button Grid.Column="2" Content="扫描平台" Icon="{ui:SymbolIcon Search24}" Style="{StaticResource ActionButton}"
                           Command="{x:Static actions:PreviewActions.ShowFeature}" CommandParameter="扫描平台" />
            </Grid>

            <DockPanel Margin="0,0,0,16">
                <TextBlock x:Name="ResultsLabel" DockPanel.Dock="Right" Text="3 款游戏" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                <TextBlock Text="全部游戏" FontSize="18" FontWeight="SemiBold" />
            </DockPanel>
            <ItemsControl x:Name="GamesList" Margin="-6,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="0" Margin="6,0,6,12">
                            <StackPanel>
                                <Border Height="170" Background="{Binding PosterBrush}" CornerRadius="11,11,0,0" ClipToBounds="True">
                                    <Grid ClipToBounds="True">
                                        <Ellipse Width="160" Height="160" Stroke="#28FFFFFF" StrokeThickness="1" HorizontalAlignment="Right" Margin="0,-54,-26,0" VerticalAlignment="Top" />
                                        <Ellipse Width="112" Height="112" Stroke="#30FFFFFF" StrokeThickness="1" HorizontalAlignment="Right" Margin="0,-30,-2,0" VerticalAlignment="Top" />
                                        <Path Data="M 0,110 L 68,40 L 105,78 L 162,0 L 270,122 Z" Fill="#22FFFFFF" Stretch="Fill" Height="100" VerticalAlignment="Bottom" />
                                        <TextBlock Text="{Binding Number}" FontSize="90" FontWeight="Thin" Foreground="#30FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,10" />
                                        <StackPanel Margin="20,0,12,22" VerticalAlignment="Bottom">
                                            <TextBlock Text="COVER PREVIEW" FontSize="9" Foreground="#B9D8D5" Margin="0,0,0,8" />
                                            <TextBlock Text="{Binding EnglishName}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" MaxWidth="190" HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <Border Background="#550E1417" CornerRadius="4" Padding="7,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16">
                                            <TextBlock Text="{Binding Platform}" FontSize="9" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Margin="16,17,16,12">
                                    <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Genre}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,12" />
                                    <DockPanel Margin="0,0,0,16">
                                        <TextBlock Text="{Binding Size}" DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Text="●  已安装" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                                    </DockPanel>
                                    <ui:Button Content="启动游戏" Icon="{ui:SymbolIcon Play24}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"
                                               Command="{x:Static actions:PreviewActions.ShowFeature}" CommandParameter="{Binding LaunchAction}" />
                                    <Grid Margin="0,8,0,14">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <ui:Button Content="备份存档" Padding="5,8" FontSize="12" MinHeight="36" HorizontalAlignment="Stretch" Margin="0,0,4,0"
                                                   Command="{x:Static actions:PreviewActions.ShowFeature}" CommandParameter="{Binding BackupAction}" />
                                        <ui:Button Grid.Column="1" Content="无损搬家" Padding="5,8" FontSize="12" MinHeight="36" HorizontalAlignment="Stretch" Margin="4,0,0,0"
                                                   Command="{x:Static actions:PreviewActions.ShowFeature}" CommandParameter="{Binding MoveAction}" />
                                    </Grid>
                                    <TextBlock Text="{Binding LastPlayed, StringFormat=上次游玩：{0}}" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border x:Name="EmptyState" Visibility="Collapsed" Style="{StaticResource Card}" Padding="32">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="没有找到匹配的游戏" FontSize="18" HorizontalAlignment="Center" />
                    <TextBlock Text="换个关键词，或清空搜索查看全部游戏。" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
