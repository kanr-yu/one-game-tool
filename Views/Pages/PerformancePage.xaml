<Page x:Class="GameDeck.Views.Pages.PerformancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:actions="clr-namespace:GameDeck.Infrastructure"
      Style="{StaticResource PageStyle}" Title="性能与面板">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,30,32,28">
            <TextBlock Text="STAY IN THE GAME" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="性能与面板" Style="{StaticResource PageTitle}" />
            <TextBlock Text="掌握运行状态，让每一次游戏都更从容。" Style="{StaticResource MutedText}" />
            <Border Style="{StaticResource Card}" Margin="0,26,0,28" Background="#202E2D" Padding="26">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,22,0">
                        <TextBlock Text="轻量 HUD，专注当下。" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="帧率、硬件温度与占用率，一眼尽览。" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
                        <TextBlock Text="以下数值为静态样式预览" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,20,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#131B1D" CornerRadius="10" BorderBrush="#456258" BorderThickness="1" Padding="24,20" MinWidth="260">
                        <StackPanel>
                            <DockPanel><TextBlock Text="HUD / PREVIEW" FontSize="10" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="●" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" /></DockPanel>
                            <TextBlock Text="144 FPS" Foreground="{StaticResource AccentBrush}" FontSize="32" FontWeight="SemiBold" Margin="0,10,0,10" />
                            <TextBlock Text="GPU  62°C   /   CPU  48%" FontFamily="Consolas" FontSize="12" Foreground="#D4DEDF" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <TextBlock Text="游戏体验" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}" Padding="24,5">
                <StackPanel>
                    <Grid Margin="0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,26,0">
                            <TextBlock Text="开启游戏内轻量悬浮窗" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="在游戏画面上显示帧率与硬件状态。" Style="{StaticResource MutedText}" Margin="0,7,0,0" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="True" OnContent="已开启" OffContent="已关闭" VerticalAlignment="Center"
                                         AutomationProperties.Name="开启游戏内轻量悬浮窗" Command="{x:Static actions:PreviewActions.ShowFeature}" CommandParameter="开启游戏内轻量悬浮窗" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource LineBrush}" />
                    <Grid Margin="0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,26,0">
                            <TextBlock Text="游戏启动自动提权" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="启动游戏时请求管理员权限，以兼容需要权限的游戏。" Style="{StaticResource MutedText}" Margin="0,7,0,0" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="False" OnContent="已开启" OffContent="已关闭" VerticalAlignment="Center"
                                         AutomationProperties.Name="游戏启动自动提权" Command="{x:Static actions:PreviewActions.ShowFeature}" CommandParameter="游戏启动自动提权" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource LineBrush}" />
                    <Grid Margin="0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,26,0">
                            <TextBlock Text="游戏结束后显示游玩摘要" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="回顾本次游玩时长与平均帧率。" Style="{StaticResource MutedText}" Margin="0,7,0,0" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="True" OnContent="已开启" OffContent="已关闭" VerticalAlignment="Center"
                                         AutomationProperties.Name="游戏结束后显示游玩摘要" Command="{x:Static actions:PreviewActions.ShowFeature}" CommandParameter="游戏结束后显示游玩摘要" />
                    </Grid>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <ui:Button Content="测试悬浮窗" Icon="{ui:SymbolIcon Play24}" Style="{StaticResource PrimaryButton}"
                           Command="{x:Static actions:PreviewActions.ShowFeature}" CommandParameter="测试悬浮窗" />
                <TextBlock Text="先预览，再进入游戏。" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="16,0,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
