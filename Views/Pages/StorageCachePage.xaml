<Page x:Class="GameDeck.Views.Pages.StorageCachePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:actions="clr-namespace:GameDeck.Infrastructure"
      Style="{StaticResource PageStyle}" Title="存储与缓存">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,30,32,28">
            <TextBlock Text="SPACE TO PLAY" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="存储与缓存" Style="{StaticResource PageTitle}" />
            <TextBlock Text="看清空间去向，为下一款大作腾出位置。" Style="{StaticResource MutedText}" />
            <Border Style="{StaticResource Card}" Margin="0,24,0,28" Padding="24">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Background="#263D35" CornerRadius="5" Padding="9,5" VerticalAlignment="Top">
                            <TextBlock Text="空间充足" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="本地磁盘  D:" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="游戏与存档所在磁盘 · 演示数据" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,23,0,14">
                        <TextBlock DockPanel.Dock="Right" Text="共 1,000 GB" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" />
                        <TextBlock FontSize="25" FontWeight="SemiBold"><Run Text="642.5" /><Run Text=" GB 已使用" FontSize="13" FontWeight="Normal" Foreground="{StaticResource MutedBrush}" /></TextBlock>
                    </DockPanel>
                    <ProgressBar Value="64.25" Maximum="100" Height="12" Foreground="{StaticResource AccentBrush}" Background="#353E44" AutomationProperties.Name="磁盘空间已使用 64.25%" />
                    <Grid Margin="0,15,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="已使用 64.25%" Style="{StaticResource MutedText}" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="可用 357.5 GB" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                    </Grid>
                </StackPanel>
            </Border>
            <DockPanel Margin="0,0,0,16">
                <TextBlock DockPanel.Dock="Right" Text="预计可释放 24.5 GB" Foreground="{StaticResource WarmBrush}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="缓存概览" FontSize="18" FontWeight="SemiBold" />
            </DockPanel>
            <ItemsControl x:Name="CachesList" Margin="-6,0,-6,25">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="6,0" Padding="20">
                            <StackPanel>
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Accent}" FontSize="23" Margin="0,0,0,18" />
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Margin="0,10,0,9"><Run Text="{Binding Size}" FontSize="30" FontWeight="SemiBold" /><Run Text=" GB" Foreground="{StaticResource MutedBrush}" /></TextBlock>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" FontSize="11" MinHeight="34" />
                                <ui:Button Content="立即清理" Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch" Margin="0,18,0,0"
                                           Command="{x:Static actions:PreviewActions.ShowFeature}" CommandParameter="{Binding CleanAction}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="历史备份存档" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}" Padding="20,2">
                <ItemsControl x:Name="BackupsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,15">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="7" Background="#2F3C3B" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Save24" Foreground="{StaticResource AccentBrush}" FontSize="17" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Game}" FontSize="14" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="15,0,24,0" />
                                <ui:Button Grid.Column="3" Content="恢复存档" Style="{StaticResource ActionButton}" VerticalAlignment="Center"
                                           Command="{x:Static actions:PreviewActions.ShowFeature}" CommandParameter="{Binding RestoreAction}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
